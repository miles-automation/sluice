{
  "name": "mcp-sluice",
  "version": "0.1.0",
  "description": "Passthrough MCP server that materializes tool results into a DuckDB scratch database",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "duckdb"
  ],
  "homepage": "https://github.com/miles-automation/sluice/tree/main/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miles-automation/sluice.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/miles-automation/sluice/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sluice": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.1-r.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@noble/hashes": "2.4.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "ajv": "^8.20.0",
    "fast-check": "^4.11.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
