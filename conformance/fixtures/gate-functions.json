    {
      "id": "gate.function.user-macro-reaching-a-denied-function",
      "spec": "001 §6.1",
      "setup": [
        "CREATE TABLE mine (a BIGINT, b VARCHAR)",
        "INSERT INTO mine VALUES (1, 'x'), (2, 'y')",
        "CREATE TABLE other (a BIGINT)",
        "INSERT INTO other VALUES (1), (3)",
        "CREATE TABLE sluice_calls (a BIGINT, scope_id VARCHAR, flat_tables VARCHAR[])",
        "CREATE VIEW sluice_calls__0123 AS SELECT * FROM sluice_calls",
        "CREATE TABLE gone (a BIGINT)",
        "CREATE MACRO nap(x) AS \"sleep_ms\"(x)",
        "CREATE MACRO nap_twice(x) AS nap(x) + nap(x)"
      ],
      "sql": "SELECT nap_twice(1)",
      "expect": {
        "decision": "reject",
        "categories": [
          "function"
        ],
        "mentions": [
          "nap_twice"
        ]
      },
      "description": "Macro definitions are followed transitively, quoted calls included."
    },
