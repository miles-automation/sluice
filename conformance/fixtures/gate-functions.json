{
  "kind": "gate",
  "description": "Function calls (spec 001 §6.1): mutating, blocking, plan-binding and attacker-sized allocation functions are refused by name as written, before macro expansion; macros that run a query or reach a denied function are refused transitively. Ordinary scalar functions, macros and aggregates still work.",
  "defaults": {
    "setup": [
      "CREATE TABLE mine (a BIGINT, b VARCHAR)",
      "INSERT INTO mine VALUES (1, 'x'), (2, 'y')",
      "CREATE TABLE other (a BIGINT)",
      "INSERT INTO other VALUES (1), (3)",
      "CREATE TABLE sluice_calls (a BIGINT, scope_id VARCHAR, flat_tables VARCHAR[])",
      "CREATE VIEW sluice_calls__0123 AS SELECT * FROM sluice_calls",
      "CREATE TABLE gone (a BIGINT)"
    ],
    "allowed": [
      "mine",
      "other"
    ],
    "evicted": [
      "gone"
    ]
  },
  "cases": [
    {
      "id": "gate.function.unnest-range",
      "spec": "001 §6.1",
      "sql": "SELECT unnest(range(1000000000))",
      "expect": {
        "decision": "reject",
        "categories": [
          "function"
        ]
      }
    },
