        "mentions": [
          "max_session_bytes"
        ]
      }
    },
    {
      "id": "config.byte-order-mark-is-refused",
      "spec": "001 §7",
      "note": "TOML text has no byte order mark; Python's tomllib refuses one, so both versions do.",
      "toml": "﻿[servers.gh]\ncommand = \"npx\"\n",
      "expect": {
        "error": true
      }
    }
  ]
