      "id": "config.limit-cross-check-above-2-53-is-exact",
      "spec": "001 §7",
      "toml": "[servers.gh]\ncommand = \"npx\"\n[limits]\nmax_payload_bytes = 100000000000000000001\nmax_session_bytes = 100000000000000000000\n",
      "expect": {
        "error": true,
        "mentions": [
          "max_session_bytes"
        ]
      }
    },
    {
      "id": "config.pagination-max-bytes-above-2-53-is-compared-exactly",
      "spec": "002 §2",
      "toml": "[servers.gh]\ncommand = \"npx\"\n[limits]\nmax_session_bytes = 100000000000000000000\n[pagination.list]\nmax_bytes = 100000000000000000001\n",
      "expect": {
