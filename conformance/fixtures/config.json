{
  "kind": "config",
  "description": "Parsing and validating sluice.toml (spec 001 §7, spec 002 §2). The file format is shared by every version. Each case is a TOML document plus the environment ${VAR} expansion reads; errors must name the offending key where `mentions` says so. `mentions` lists configuration keys, table names or variable names the error must name; error wording is not part of the contract.",
  "cases": [
    {
      "id": "config.minimal-config-parses",
      "spec": "001 §7",
      "description": "The defaults of spec 001 §7.",
      "toml": "[servers.gh]\ncommand = \"npx\"\n",
      "expect": {
        "ok": true,
        "server": {
          "name": "gh",
          "command": "npx",
          "args": [],
          "cwd": null
        },
        "limits": {
          "max_payload_bytes": 1048576,
          "max_concurrent_materializations": 2,
          "preview_bytes": 2048,
          "preview_rows": 3,
          "max_columns": 64,
          "query_timeout_seconds": 10.0,
          "query_max_rows": 100,
          "query_max_bytes": 65536,
          "max_cell_bytes": 512,
          "duckdb_max_memory": "1GB",
          "max_session_bytes": 268435456,
          "max_session_calls": 1000
        }
      }
    },
    {
      "id": "config.example-config-is-valid",
      "spec": "001 §7",
      "note": "Whatever ${VAR} references the example file holds must be listed in environ.",
      "toml_file": "sluice.example.toml",
      "environ": {
        "GITHUB_TOKEN": "x"
      },
      "expect": {
        "ok": true
      }
    },
    {
      "id": "config.env-vars-expand",
      "spec": "001 §7",
      "toml": "[servers.s]\ncommand = \"${BIN}/server\"\nargs = [\"--token\", \"${TOKEN}\"]\nenv = { TOKEN = \"${TOKEN}\" }\n",
      "environ": {
        "BIN": "/opt/bin",
        "TOKEN": "t0k"
      },
      "expect": {
        "ok": true,
        "server": {
          "command": "/opt/bin/server",
          "args": [
            "--token",
            "t0k"
          ],
          "env": {
            "TOKEN": "t0k"
          }
        }
      }
    },
    {
      "id": "config.missing-env-var-is-an-error",
      "spec": "001 §7",
      "toml": "[servers.s]\ncommand = \"${NOPE}\"\n",
      "expect": {
        "error": true,
        "mentions": [
          "NOPE"
        ]
      }
    },
    {
      "id": "config.no-servers",
      "spec": "001 FR-6",
      "toml": "[limits]\nmax_columns = 3\n",
      "expect": {
        "error": true,
        "mentions": [
          "servers"
        ]
      }
    },
    {
      "id": "config.two-servers-are-refused",
      "spec": "001 FR-7",
      "toml": "[servers.alpha_server]\ncommand = \"x\"\n[servers.beta_server]\ncommand = \"y\"\n",
      "expect": {
        "error": true,
        "mentions": [
          "alpha_server",
          "beta_server"
        ]
      }
    },
