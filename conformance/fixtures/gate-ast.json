    {
      "id": "gate_ast.statement-layer-refuses-insert",
      "spec": "001 §6.1 layer 1",
      "sql": "INSERT INTO mine VALUES (3, 'z')",
      "mutations": [
        {
          "op": "replace_serialized",
          "sql": "SELECT 1"
        }
      ],
      "expect": {
        "decision": "reject",
        "categories": [
          "not_select"
        ]
      },
      "description": "The object layer sees the AST of SELECT 1, so only the statement layer can refuse this. It must refuse it as not a read."
    },
