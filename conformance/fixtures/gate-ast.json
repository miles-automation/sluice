{
  "kind": "gate_ast",
  "description": "The gate's walker over DuckDB's serialized AST fails closed (spec 001 §6.1). Each case serializes `sql` with the engine under test, applies `mutations` to the parsed document, and hands the mutated document to the walker in place of the real one. The statement layer still sees the original SQL. See conformance/README.md for the mutation operations. Cases whose first mutation is `replace_serialized` never serialize their own SQL, which isolates the statement layer (layer 1).",
  "defaults": {
    "setup": [
      "CREATE TABLE mine (a BIGINT, b VARCHAR)",
      "INSERT INTO mine VALUES (1, 'x'), (2, 'y')",
      "CREATE TABLE other (a BIGINT)",
      "INSERT INTO other VALUES (1), (3)",
      "CREATE TABLE sluice_calls (a BIGINT, scope_id VARCHAR, flat_tables VARCHAR[])",
      "CREATE VIEW sluice_calls__0123 AS SELECT * FROM sluice_calls",
      "CREATE TABLE gone (a BIGINT)"
    ],
    "allowed": [
      "mine",
      "other"
    ],
    "evicted": [
      "gone"
    ]
  },
  "cases": [
    {
      "id": "gate_ast.renamed-cte-body",
      "spec": "001 §6.1",
      "sql": "WITH x AS (SELECT * FROM mine) SELECT * FROM x",
      "mutations": [
        {
          "op": "rename_first",
          "path": [
            "statements",
            0,
            "node",
            "cte_map",
            "map",
            0,
            "value"
          ],
          "keys": [
            "query_node",
            "query"
          ],
          "to": "future_body"
        }
      ],
      "expect": {
        "decision": "reject",
        "categories": [
          "unanalyzable"
        ]
      },
      "description": "The DuckDB 2.0 class of change: a CTE body moved and the walker must refuse, not skip."
    },
    {
      "id": "gate_ast.cte-map-without-a-list",
      "spec": "001 §6.1",
      "sql": "WITH x AS (SELECT * FROM mine) SELECT * FROM x",
      "mutations": [
        {
          "op": "set",
          "path": [
            "statements",
            0,
            "node",
            "cte_map"
          ],
          "value": {
            "future_map": []
          }
        }
      ],
      "expect": {
        "decision": "reject",
        "categories": [
          "unanalyzable"
        ]
      }
    },
    {
      "id": "gate_ast.cte-map-not-an-object",
      "spec": "001 §6.1",
      "sql": "WITH x AS (SELECT * FROM mine) SELECT * FROM x",
      "mutations": [
        {
          "op": "set",
          "path": [
            "statements",
            0,
            "node",
            "cte_map"
          ],
          "value": [
            "x"
          ]
        }
      ],
      "expect": {
        "decision": "reject",
        "categories": [
          "unanalyzable"
        ]
      }
    },
