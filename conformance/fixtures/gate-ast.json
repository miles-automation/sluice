        {
          "op": "set",
          "path": [
            "statements",
            0,
            "node",
            "cte_map",
            "map",
            0
          ],
          "value": {
            "name": "x"
          }
        }
      ],
      "expect": {
        "decision": "reject",
        "categories": [
          "unanalyzable"
        ]
      }
    },
