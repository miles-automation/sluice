      }
    },
    {
      "id": "engine.integer-sum-is-exact-hugeint",
      "spec": "001 §5.6",
      "setup": [
        "CREATE TABLE t (v BIGINT)",
        "INSERT INTO t VALUES (9007199254740992), (9007199254740992)"
      ],
      "sql": "SELECT sum(v) FROM t",
      "expect": {
