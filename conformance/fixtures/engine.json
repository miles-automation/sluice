        "CREATE TABLE t (v BIGINT)",
        "INSERT INTO t VALUES (0), (9223372036854775806), (9223372036854775807)"
      ],
      "sql": "SELECT median(v) FROM t",
      "expect": {
        "rows": [
          [
            {
              "double": "9.223372036854776e18"
            }
          ]
        ]
      }
    },
    {
      "id": "engine.max-of-mixed-double-rounds",
      "spec": "001 §5.5",
      "description": "The true maximum is 9007199254740993.",
      "setup": [
        "CREATE TABLE t (v DOUBLE)",
        "INSERT INTO t VALUES (CAST(9007199254740993 AS DOUBLE)), (0.5)"
      ],
      "sql": "SELECT max(v) FROM t",
      "expect": {
        "rows": [
          [
            {
              "double": "9007199254740992"
            }
