{
  "kind": "session",
  "description": "Session retention and truncation reporting (spec 001 §7): oldest calls are evicted deterministically, a handle never advertises a table that is gone, an evicted table is reported as evicted, and envelope metadata survives.",
  "cases": [
    {
      "id": "session.retention.oldest-call-is-evicted-coherently",
      "spec": "001 §3.1, §7",
      "note": "Retention sizes are a logical estimate and implementation-defined (spec 001 §7). Each call here retains about 1,260 bytes in Python; the budget sits at 1.5 times that, so any estimate between 0.75 and 1.5 times Python's gives the same outcome.",
      "limits": {
        "max_payload_bytes": 1800,
        "max_session_bytes": 1900
      },
      "steps": [
        {
          "call": "c1",
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"items\": [{\"id\": 1, \"padding\": \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"}]}"
              }
            ]
          },
          "expect": {
            "outcome": "handle",
            "tables": [
              {
                "source_path": "$.items",
                "row_count": 1
              }
            ]
          }
        },
        {
          "call": "c2",
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"items\": [{\"id\": 2, \"padding\": \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"}]}"
              }
            ]
          },
          "expect": {
            "outcome": "handle",
            "tables": [
              {
                "source_path": "$.items",
                "row_count": 1
              }
            ]
          }
        },
        {
          "query": {
            "sql": "SELECT * FROM \"{{c1.table}}\""
          },
          "expect": {
            "error": true,
            "categories": [
              "evicted_table"
            ]
          }
        },
        {
          "query": {
            "sql": "SELECT id FROM \"{{c2.table}}\""
          },
          "expect": {
            "rows": [
              [
                2
              ]
            ]
          }
        },
        {
          "query": {
            "sql": "SELECT tool, content_kinds[1], len(flat_tables), regexp_extract(flat_reason, '^[^:;]*'), result IS NULL, result_text IS NULL, args IS NULL FROM \"{{c1.envelope}}\""
          },
          "expect": {
            "rows": [
              [
                "tool",
                "text",
                0,
                "retention_evicted",
                {
                  "bool": true
                },
                {
                  "bool": true
                },
                {
                  "bool": true
                }
              ]
            ]
          }
        },
        {
          "query": {
            "sql": "SELECT len(flat_tables), flat_reason IS NULL FROM \"{{c2.envelope}}\""
          },
          "expect": {
            "rows": [
              [
                1,
                {
                  "bool": true
                }
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "session.retention.call-larger-than-the-budget-degrades-safely",
      "spec": "001 §3.1, §7",
      "note": "This call retains about 4,470 bytes in Python against a 1,900-byte budget.",
      "limits": {
        "max_payload_bytes": 1800,
        "max_session_bytes": 1900
      },
      "steps": [
        {
          "call": "c1",
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"items\": [{\"id\": 1, \"padding\": \"\"}]}"
              }
            ]
          },
          "expect": {
            "outcome": "handle",
            "tables": [],
            "flat_reason": "retention_budget_exceeded"
          }
        },
        {
          "query": {
            "sql": "SELECT len(flat_tables), regexp_extract(flat_reason, '^[^:;]*'), result IS NULL FROM \"{{c1.envelope}}\""
          },
          "expect": {
            "rows": [
              [
                0,
                "retention_budget_exceeded",
                {
                  "bool": true
                }
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "session.retention.over-budget-call-does-not-evict-healthy-calls",
      "spec": "001 §7",
      "note": "The small calls retain about 460 bytes each in Python.",
      "limits": {
        "max_payload_bytes": 1800,
        "max_session_bytes": 1900
      },
      "steps": [
        {
          "call": "c1",
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"items\": [{\"id\": 1, \"padding\": \"\"}]}"
              }
            ]
          },
          "expect": {
            "outcome": "handle"
          }
        },
        {
          "call": "c2",
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"items\": [{\"id\": 2, \"padding\": \"\"}]}"
              }
            ]
          },
          "expect": {
            "outcome": "handle"
          }
        },
        {
          "call": "c3",
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"items\": [{\"id\": 3, \"padding\": \"\"}]}"
              }
            ]
          },
          "expect": {
            "outcome": "handle",
            "tables": [],
            "flat_reason": "retention_budget_exceeded"
          }
        },
        {
          "query": {
            "sql": "SELECT id FROM \"{{c1.table}}\""
          },
          "expect": {
            "rows": [
              [
                1
              ]
            ]
          }
        },
        {
          "query": {
            "sql": "SELECT id FROM \"{{c2.table}}\""
          },
          "expect": {
            "rows": [
              [
                2
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "session.retention.call-cap-deletes-old-scopes",
      "spec": "001 §7",
      "description": "max_session_calls deletes the oldest metadata row; a scope view goes with its last row.",
      "limits": {
        "max_payload_bytes": 1000,
        "max_session_bytes": 100000,
        "max_session_calls": 2
      },
      "steps": [
        {
          "call": "c1",
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"items\": [{\"id\": 0, \"padding\": \"\"}]}"
              }
            ]
          },
          "expect": {
            "outcome": "handle"
          }
        },
        {
          "call": "c2",
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"items\": [{\"id\": 1, \"padding\": \"\"}]}"
              }
            ]
          },
          "expect": {
            "outcome": "handle"
          }
        },
        {
          "call": "c3",
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"items\": [{\"id\": 2, \"padding\": \"\"}]}"
              }
            ]
          },
          "expect": {
            "outcome": "handle"
          }
        },
        {
          "query": {
            "sql": "SELECT * FROM \"{{c1.table}}\""
          },
          "expect": {
            "error": true,
            "categories": [
              "evicted_table",
              "unknown_table"
            ]
          }
        },
        {
          "query": {
            "sql": "SELECT * FROM \"{{c1.envelope}}\""
          },
          "expect": {
            "error": true,
            "categories": [
              "unknown_table",
              "evicted_table"
            ]
          }
        },
        {
          "query": {
            "sql": "SELECT id FROM \"{{c3.table}}\""
          },
          "expect": {
            "rows": [
              [
                2
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "session.retention.call-cap-keeps-a-shared-scope-view",
      "spec": "001 §7",
      "limits": {
        "max_payload_bytes": 1000,
        "max_session_bytes": 100000,
        "max_session_calls": 2
      },
      "steps": [
