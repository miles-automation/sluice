          "expect": {
            "outcome": "handle"
          }
        },
        {
          "call": "c2",
          "meta": {
            "sessionId": "same"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"items\": [{\"id\": 2, \"padding\": \"\"}]}"
              }
            ]
          },
          "expect": {
            "outcome": "handle"
          }
        },
        {
          "call": "c3",
          "meta": {
            "sessionId": "same"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"items\": [{\"id\": 3, \"padding\": \"\"}]}"
              }
            ]
          },
          "expect": {
            "outcome": "handle"
          }
        },
        {
          "query": {
            "sql": "SELECT count(*), min(seq) FROM \"{{c1.envelope}}\""
          },
          "expect": {
            "rows": [
              [
                2,
                2
              ]
            ]
          }
        },
        {
          "query": {
            "sql": "SELECT * FROM \"{{c1.table}}\""
          },
          "expect": {
            "error": true,
            "categories": [
              "evicted_table",
              "unknown_table"
            ]
          }
        }
      ]
    },
