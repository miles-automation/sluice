      "expect": {
        "status": "complete",
        "reason": "complete",
        "pages": 3,
        "bytes": 254
      },
      "collection": {
        "outcome": "handle",
        "table_rows": 10,
        "status": "complete",
        "reason": "complete"
      }
    },
    {
      "id": "paginate.first-page-over-max-bytes-yields-nothing",
      "spec": "002 PG-7, PG-12",
      "description": "No page fetched; the caller turns this into an error (PG-12), never an empty table.",
      "config": {
        "page_size": 10,
        "max_bytes": 97
      },
      "pages": {
        "0": {
          "text": "{\"items\": [{\"i\": 0}, {\"i\": 1}, {\"i\": 2}, {\"i\": 3}, {\"i\": 4}], \"has_more\": true, \"next_offset\": 10}"
        }
      },
      "expect": {
        "status": "partial",
        "reason": "max_bytes",
        "pages": 0,
        "bytes": 0,
        "resume_offset": 0,
        "rows": []
      },
      "collection": {
        "outcome": "error",
        "keeps_downstream_error": false
      }
    },
