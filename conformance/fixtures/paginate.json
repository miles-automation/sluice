        }
      },
      "expect": {
        "status": "partial",
        "reason": "max_bytes",
        "pages": 1,
        "bytes": 98,
        "resume_offset": 10,
        "rows": [
          {
            "i": 0
          },
          {
            "i": 1
          },
          {
            "i": 2
          },
          {
            "i": 3
          },
          {
            "i": 4
          }
        ]
      },
      "collection": {
        "outcome": "handle",
        "table_rows": 5,
        "status": "partial",
        "reason": "max_bytes",
        "resume_offset": 10
      }
    },
