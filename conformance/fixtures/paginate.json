      },
      "pages": {
        "10": {
          "text": "{\"items\": [{\"i\": 10}], \"has_more\": true, \"next_offset\": 20}"
        },
        "20": {
          "text": "{\"items\": [{\"i\": 20}], \"has_more\": false, \"next_offset\": null}"
        }
      },
      "expect": {
        "status": "complete",
        "reason": "complete",
        "pages": 2,
        "calls": [
          {
            "limit": 10,
            "offset": 10
          },
          {
            "limit": 10,
            "offset": 20
          }
        ]
      },
      "collection": {
        "outcome": "handle",
        "table_rows": 2,
        "status": "complete",
        "reason": "complete"
      }
    },
