        },
        "40": {
          "text": "{\"items\": [{\"i\": 40}], \"has_more\": true, \"next_offset\": 50}"
        },
        "50": {
          "text": "{\"items\": [{\"i\": 50}], \"has_more\": true, \"next_offset\": 60}"
        },
        "60": {
          "text": "{\"items\": [{\"i\": 60}], \"has_more\": true, \"next_offset\": 70}"
        },
        "70": {
          "text": "{\"items\": [{\"i\": 70}], \"has_more\": true, \"next_offset\": 80}"
        },
        "80": {
          "text": "{\"items\": [{\"i\": 80}], \"has_more\": true, \"next_offset\": 90}"
        },
        "90": {
          "text": "{\"items\": [{\"i\": 90}], \"has_more\": true, \"next_offset\": 100}"
        }
      },
      "expect": {
        "status": "partial",
        "reason": "max_pages",
        "pages": 2,
        "resume_offset": 20,
        "rows": [
          {
            "i": 0
          },
          {
            "i": 10
          }
        ]
      },
      "collection": {
        "outcome": "handle",
        "table_rows": 2,
        "status": "partial",
        "reason": "max_pages",
        "resume_offset": 20
      }
    },
    {
      "id": "paginate.max-bytes-never-keeps-the-crossing-page",
      "spec": "002 PG-7",
      "description": "Page bytes are the UTF-8 length of the page's text content (spec 001 §5.1 candidate size).",
