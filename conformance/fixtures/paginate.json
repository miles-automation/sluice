{
  "kind": "paginate",
  "description": "The bounded page loop (spec 002 §4) driven by a scripted downstream: `pages` maps each requested offset to the page the tool returns. Expected outcomes cover completion, every stop reason, resume offsets and the exact arguments sent per page. The max_seconds wall clock is timing-dependent and not covered here. Where a case has `collection`, the runner also drives the collection tool end to end (spec 002 PG-10 to PG-12) with the same scripted pages: a fetch that got no page must be a tool error with no handle and no table, never an empty table; one that got rows returns one table carrying the pagination status.",
  "cases": [
    {
      "id": "paginate.forwards-filters-and-managed-arguments",
      "spec": "002 PG-5, PG-6",
      "config": {
        "page_size": 10
      },
      "arguments": {
        "q": "x"
      },
      "pages": {
        "0": {
          "text": "{\"items\": [{\"i\": 0}], \"has_more\": true, \"next_offset\": 10}"
        },
        "10": {
          "text": "{\"items\": [{\"i\": 10}], \"has_more\": true, \"next_offset\": 20}"
        },
        "20": {
          "text": "{\"items\": [{\"i\": 20}], \"has_more\": false, \"next_offset\": 30}"
        }
      },
      "expect": {
        "status": "complete",
        "reason": "complete",
        "pages": 3,
        "resume_offset": null,
        "rows": [
          {
            "i": 0
          },
          {
            "i": 10
          },
          {
            "i": 20
          }
        ],
        "calls": [
          {
            "q": "x",
            "limit": 10,
            "offset": 0
          },
          {
            "q": "x",
            "limit": 10,
            "offset": 10
          },
          {
            "q": "x",
            "limit": 10,
            "offset": 20
          }
        ]
      },
      "collection": {
        "outcome": "handle",
        "table_rows": 3,
        "status": "complete",
        "reason": "complete",
        "resume_offset": null
      }
    },
    {
      "id": "paginate.a-single-page-is-complete",
      "spec": "002 §4",
      "config": {
        "page_size": 10
      },
      "pages": {
        "0": {
          "text": "{\"items\": [{\"i\": 0}, {\"i\": 1}, {\"i\": 2}], \"has_more\": false, \"next_offset\": null}"
        }
      },
      "expect": {
        "status": "complete",
        "reason": "complete",
        "pages": 1,
        "rows": [
          {
            "i": 0
          },
          {
            "i": 1
          },
          {
            "i": 2
          }
        ]
      },
      "collection": {
        "outcome": "handle",
        "table_rows": 3,
        "status": "complete",
        "reason": "complete"
      }
    },
    {
