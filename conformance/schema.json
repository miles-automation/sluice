      "type": "object",
      "required": [
        "query",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "object",
          "description": "The raw `query` tool arguments. String values may hold placeholders {{<call>.table}}, {{<call>.table.<n>}}, {{<call>.envelope}}, {{<call>.call_id}}, {{<call>.scope}}."
        },
        "expect": {
          "$ref": "#/$defs/queryExpect"
        }
      }
    },
    "sessionCase": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
